{
  "expo": {
    "name": "DOTO",
    "slug": "doto",
    "version": "0.1.11",
    "icon": "./assets/branding/doto-app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.doto.habits",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/doto-adaptive-foreground.png",
        "backgroundColor": "#F2E7DF"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.doto.habits"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/doto-notification-icon.png",
          "color": "#E98651"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
